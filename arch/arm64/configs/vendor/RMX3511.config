# realme C35 (RMX3511, ums9230_nico)
# Generated from: sprd-diffconfig/androids/qogirl6/arm64/ums9230_nico_diff_config, sprd-diffconfig/androidt/qogirl6/arm64/aarch64_user_diff_config
# (same semantics as scripts/sprd/sprd_create_user_config.sh)

# CONFIG_ENABLE_DEFAULT_TRACERS is not set
# CONFIG_E_SHOW_MEM is not set
# CONFIG_FUNCTION_TRACER is not set
# CONFIG_IRQSOFF_TRACER is not set
CONFIG_OPLUS_DEVICE_IFNO=m
# CONFIG_OPPO_DEVICE_IFNO is not set
# CONFIG_PREEMPT_TRACER is not set
CONFIG_SDIOHAL=y
# CONFIG_SPRD_CMA_DEBUG is not set
# CONFIG_SPRD_DEBUG is not set
# CONFIG_SPRD_THERMAL_DEBUG is not set
# CONFIG_TRACER_SNAPSHOT is not set
CONFIG_UMW2652=y
CONFIG_WCN_BOOT=y
# CONFIG_WCN_INTEG is not set
CONFIG_WCN_SLP=y

# CONFIG_MODULE_SIG* from the stock user diffconfig are intentionally left
# out: stock enforces signed modules (MODULE_SIG_FORCE), which would break
# loading anything not signed with the build's own key.
